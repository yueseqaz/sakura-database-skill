{
  "name": "sakura-database-skill",
  "version": "0.11.0",
  "description": "A universal database skill and TypeScript CLI for AI agents.",
  "private": false,
  "type": "module",
  "bin": {
    "sakura-db": "dist/db-agent.js",
    "sakura-db-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "agents",
    "references",
    "README.md",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yueseqaz/sakura-database-skill.git"
  },
  "scripts": {
    "db-agent": "tsx scripts/db-agent.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "test": "tsx --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mysql2": "^3.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
